{
  "manifest_version": 3,
  "name": "Xorcism",
  "version": "0.3.0",
  "minimum_chrome_version": "114",
  "description": "Select visible accounts on X, review the queue, and block them sequentially through X's own controls.",
  "action": {
    "default_title": "Open Xorcism",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "js": [
        "src/shared/namespace.js",
        "src/shared/messages.js",
        "src/shared/handle-utils.js",
        "src/shared/geometry-utils.js",
        "src/content/x-adapter.js",
        "src/content/selection-controller.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
